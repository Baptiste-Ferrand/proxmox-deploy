apiVersion: v1
kind: Secret
metadata:
  name: {{ argocd_gitops_repository_name }}-repository
  namespace: {{ argocd_namespace }}
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
stringData:
  type: git
  url: {{ argocd_gitops_repository_url }}
  sshPrivateKey: |
{{ argocd_gitops_repository_ssh_private_key | indent(4, true) }}